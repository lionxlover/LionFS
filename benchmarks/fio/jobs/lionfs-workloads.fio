[seq-write]
description=Sequential 64 KiB writes (the LionFS harness's strongest workload)
filename=fseq.bin
rw=write
bs=64k
iodepth=16
direct=1
ioengine=psync
size=1g
runtime=15
time_based=1
group_reporting=1

[seq-read]
description=Sequential 64 KiB reads
filename=fseq.bin
rw=read
bs=64k
iodepth=16
direct=1
ioengine=psync
size=1g
runtime=15
time_based=1
group_reporting=1

[rand-read]
description=Random 4 KiB reads
filename=fseq.bin
rw=randread
bs=4k
iodepth=16
direct=1
ioengine=psync
size=1g
runtime=15
time_based=1
group_reporting=1

[rand-write]
description=Random 4 KiB writes
filename=fseq.bin
rw=randwrite
bs=4k
iodepth=16
direct=1
ioengine=psync
size=1g
runtime=15
time_based=1
group_reporting=1

[mixed]
description=70/30 read/write random mix
filename=fseq.bin
rw=randrw
rwmixread=70
bs=4k
iodepth=16
direct=1
ioengine=psync
size=1g
runtime=15
time_based=1
group_reporting=1
