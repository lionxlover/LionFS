group_reporting=1

# ===== 1M BLOCK SIZE =====

[seq-write-1m]
description=Sequential 1M write (peak streaming throughput)
filename=fseq.bin
rw=write
bs=1m
iodepth=4
numjobs=1
direct=1
ioengine=psync
size=2g
runtime=20
time_based=1
group_reporting=1

[seq-read-1m]
description=Sequential 1M read (peak streaming throughput)
filename=fseq.bin
rw=read
bs=1m
iodepth=4
numjobs=1
direct=1
ioengine=psync
size=2g
runtime=20
time_based=1
group_reporting=1

# ===== MIXED READ/WRITE =====

[mixed-4k-7030]
description=70/30 read/write random mix, 4K blocks (database pattern)
filename=fseq.bin
rw=randrw
rwmixread=70
bs=4k
iodepth=32
numjobs=4
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[mixed-4k-5050]
description=50/50 read/write random mix, 4K blocks (balanced)
filename=fseq.bin
rw=randrw
rwmixread=50
bs=4k
iodepth=32
numjobs=4
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1
