# extended-comparison.fio
#
# Extended FIO job file for LionFS vs competitors comparison.
# Tests block sizes: 4K, 64K, 1M
# Queue depths:      1, 32, 128
# Patterns:         seq-write, seq-read, rand-write, rand-read, mixed
#
# All jobs share fseq.bin. seq-write-64k creates it first.
# ---------------------------------------------------------------------------

# ===== 4K BLOCK SIZE =====

[rand-write-4k-qd1]
description=Random 4K write, queue depth 1 (latency-sensitive)
filename=fseq.bin
rw=randwrite
bs=4k
iodepth=1
numjobs=1
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[rand-write-4k-qd32]
description=Random 4K write, queue depth 32 (standard benchmark)
filename=fseq.bin
rw=randwrite
bs=4k
iodepth=32
numjobs=4
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[rand-write-4k-qd128]
description=Random 4K write, queue depth 128 (saturation)
filename=fseq.bin
rw=randwrite
bs=4k
iodepth=128
numjobs=16
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[rand-read-4k-qd1]
description=Random 4K read, queue depth 1
filename=fseq.bin
rw=randread
bs=4k
iodepth=1
numjobs=1
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[rand-read-4k-qd32]
description=Random 4K read, queue depth 32
filename=fseq.bin
rw=randread
bs=4k
iodepth=32
numjobs=4
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[rand-read-4k-qd128]
description=Random 4K read, queue depth 128
filename=fseq.bin
rw=randread
bs=4k
iodepth=128
numjobs=16
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

# ===== 64K BLOCK SIZE =====

[seq-write-64k]
description=Sequential 64K write (streaming throughput)
filename=fseq.bin
rw=write
bs=64k
iodepth=16
numjobs=1
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

