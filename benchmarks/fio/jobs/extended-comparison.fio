filename=fseq.bin
rw=read
bs=64k
iodepth=16
numjobs=1
direct=1
ioengine=psync
size=1g
runtime=20
time_based=1
group_reporting=1

[rand-write-64k-qd32]
description=Random 64K write, queue depth 32
filename=fseq.bin
rw=randwrite
bs=64k
iodepth=32
numjobs=4
direct=1
ioengine=psync
size=1g
runtime=20
